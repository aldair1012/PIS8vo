# El contexto de construcción solo incluye código y datos públicos necesarios.
**
!docker/
!docker/**
!frontend-app/
!frontend-app/index.html
!frontend-app/package.json
!frontend-app/package-lock.json
!frontend-app/vite.config.js
!frontend-app/src/
!frontend-app/src/**
!frontend-app/public/
!frontend-app/public/**
!backend-api/
!backend-api/src/
!backend-api/src/**
!backend-api/public/
!backend-api/public/index.php
!backend-api/data/
!backend-api/data/*.json
!backend-api/data/referencias/
!backend-api/data/referencias/*.json
!ml-engine/
!ml-engine/app.py
!ml-engine/requirements.txt
