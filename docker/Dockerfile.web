FROM node:22-bookworm-slim AS frontend
WORKDIR /build
COPY frontend-app/package.json frontend-app/package-lock.json ./
RUN npm ci
COPY frontend-app/index.html frontend-app/vite.config.js ./
COPY frontend-app/src ./src
COPY frontend-app/public ./public
RUN npx vite build

FROM php:8.2-apache
RUN apt-get update && apt-get install -y --no-install-recommends libonig-dev libcurl4-openssl-dev \
    && docker-php-ext-install pdo_mysql mbstring curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /var/www/html/ZeaSys
COPY --from=frontend /build/dist/ ./
COPY backend-api/src/ ./backend-api/src/
COPY backend-api/public/index.php ./backend-api/public/index.php
COPY backend-api/data/*.json ./backend-api/data/
COPY backend-api/data/referencias/*.json ./backend-api/data/referencias/
COPY ml-engine/data/inamhi-precipitacion-2019diciembre.csv ./ml-engine/data/inamhi-precipitacion-2019diciembre.csv
RUN mkdir -p backend-api/public/uploads backend-api/data/cache \
    && chown -R www-data:www-data backend-api/public/uploads backend-api/data/cache
