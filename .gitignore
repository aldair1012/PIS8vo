# =========================================================
# ZeaSys — .gitignore raíz
# =========================================================

# Dependencias (frontend)
node_modules/

# Python
__pycache__/
*.pyc
*.pyo

# Logs
*.log
ml-engine/flask_server.log

# Caché generada en tiempo de ejecución (se regenera sola)
backend-api/data/cache/
ml-engine/models/backup_*/

# Datos subidos por usuarios (avatares) — datos personales, no versionar
backend-api/public/uploads/*
!backend-api/public/uploads/.htaccess

# Corpus RAG local: los PDF se descargan desde las fuentes oficiales indicadas
# en rag-sources/SOURCES.md; no versionar archivos binarios pesados.
rag-sources/*.pdf

# Editor / sistema
.idea/
.vscode/
.DS_Store
Thumbs.db

# Nota: los artefactos de despliegue en la raíz (index.html, assets/, models/)
# SÍ se versionan a propósito: son lo que XAMPP sirve en /ZeaSys y permiten
# revertir el sistema desplegado con un solo comando.

# Resultados locales de Playwright
frontend-app/test-results/
frontend-app/playwright-report/

# Configuración local privada de la prueba Docker
docker/.env

# Paquetes generados para revisión académica
/ZeaSys-*.zip
/ZeaSys-*.zip.sha256

# Base de datos real con datos personales (nombres, correos, hashes)
database/agropredict_db.sql
