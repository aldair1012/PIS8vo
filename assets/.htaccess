# Los archivos de esta carpeta llevan un hash en el nombre (los genera Vite) y cambian en cada
# compilación. Pueden conservarse un año sin riesgo de servir una versión vieja.
<IfModule mod_headers.c>
    <FilesMatch "^[A-Za-z0-9._-]+-[A-Za-z0-9_-]{8}\.(?:js|css|webp|svg|jpg|png|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
