# Los archivos de esta carpeta llevan un hash en el nombre (los genera Vite) y cambian en cada
# compilación. Pueden conservarse un año sin riesgo de servir una versión vieja.
<IfModule mod_headers.c>
    <FilesMatch "^[A-Za-z0-9._-]+-[A-Za-z0-9_-]{8}\.(?:js|css|webp|svg|jpg|png|woff2?)(?:\.gz)?$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(js|css)(\.gz)?$">
        Header merge Vary Accept-Encoding
    </FilesMatch>
    <FilesMatch "\.(js|css)\.gz$">
        Header set Content-Encoding gzip
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP:Accept-Encoding} "(^|,)\s*gzip\s*(;|,|$)" [NC]
    RewriteCond %{HTTP:Accept-Encoding} "!(^|,)\s*gzip\s*;\s*q=0(\.0*)?\s*(,|$)" [NC]
    RewriteCond %{REQUEST_FILENAME}.gz -s
    RewriteRule ^([\w.-]+\.(?:js|css))$ $1.gz [L]
</IfModule>
<FilesMatch "\.js\.gz$">
    ForceType application/javascript
</FilesMatch>
<FilesMatch "\.css\.gz$">
    ForceType text/css
</FilesMatch>
<IfModule mod_setenvif.c>
    SetEnvIf Request_URI "\.gz$" no-gzip=1
</IfModule>
